<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Información básica del proyecto -->
	<groupId>mymod</groupId> <!-- Tu identificador único -->
	<artifactId>mymod</artifactId> <!-- El nombre de tu mod -->
	<version>1.0</version>
	<packaging>jar</packaging>

	<name>Mi Mod de Slay the Spire</name> <!-- Nombre de tu mod -->
	<description>Un mod que añade una nueva carta al juego</description> <!-- Descripción de tu mod -->

	<!-- Dependencias necesarias -->
	<dependencies>
		<!-- BaseMod: para interactuar con Slay the Spire -->
		<dependency>
			<groupId>basemod</groupId>
			<artifactId>basemod</artifactId>
			<version>5.55.1</version>
			<scope>system</scope>
			<systemPath>${user.home}/.m2/repository/basemod/basemod/5.55.1/BaseMod.jar</systemPath>
		</dependency>

		<dependency>
			<groupId>com.megacrit.cardcrawl</groupId>
			<artifactId>slaythespire</artifactId>
			<version>1.0</version>
			<scope>system</scope>
			<systemPath>${basedir}/lib/desktop-1.0.jar</systemPath>
		</dependency>


		<!-- BaseMod: para interactuar con Slay the Spire -->

		<dependency>
			<groupId>com.megacrit.cardcrawl</groupId>
			<artifactId>slaythespire</artifactId>
			<version>015</version>
		</dependency>

		<dependency>
			<groupId>com.evacipated.cardcrawl</groupId>
			<artifactId>modthespire</artifactId>
			<version>1.0</version>
			<scope>system</scope>
			<systemPath>C:\Users\gabri\eclipse-workspace\mymod\libs\ModTheSpire.jar</systemPath>
		</dependency>


		<dependency>
			<groupId>com.evacipated.cardcrawl.mod</groupId>
			<artifactId>ActLikeIt</artifactId>
			<version>0.9.0</version>
			<scope>system</scope>
			<systemPath>C:\Users\gabri\eclipse-workspace\mymod\libs\actlikeit.jar</systemPath>
		</dependency>

		<dependency>
			<groupId>com.evacipated.cardcrawl.mod</groupId>
			<artifactId>StSLib</artifactId>
			<version>1.3.2</version>
			<scope>system</scope>
			<systemPath>C:\Users\gabri\Desktop\pic\Mod\libs\StSLib.jar</systemPath>
		</dependency>


	</dependencies>



	<!-- Construcción del JAR -->
	<build>
		<plugins>
			<!-- Plugin para empaquetar el mod en un archivo JAR -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>mod</classifier> <!-- Evita sobrescribir artefactos existentes -->
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>

</project>
